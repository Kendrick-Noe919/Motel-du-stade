# Sauvegardes et dumps de la base.
#
# Ils contiennent les noms, telephones et e-mails des clients, ainsi que les
# empreintes des mots de passe du personnel : ils nont rien a faire dans un depot.
database/
*.sql.gz

# Dependances et fichiers generes
node_modules/
dist/
build/

# Secrets et configuration locale
.env
.env.local
.env.*.local
.env.production

# Etat de l'interrupteur de licence : propre a chaque serveur, jamais dans le depot.
.etat-licence.json

# Journaux et fichiers temporaires
*.log
npm-debug.log*
.DS_Store
Thumbs.db
