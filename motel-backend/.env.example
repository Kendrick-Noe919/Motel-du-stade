DATABASE_URL="mysql://root:@localhost:3306/motel_db"
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=motel_db
JWT_SECRET=change_moi_par_une_longue_chaine_aleatoire
JWT_EXPIRES_IN=8h
PORT=5000

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules.
# En production : l'URL exacte du frontend, par exemple https://motel-du-stade.com
CORS_ORIGINS=http://localhost:5173

# ---------- Provisionnement des comptes (npm run seed) ----------
# Le domaine des adresses du personnel, et les mots de passe initiaux. Renseignez-les
# en production plutôt que de laisser les valeurs par défaut du script : les
# identifiants réels n'ont pas à vivre dans le dépôt.
SEED_DOMAINE=instant-motel.com
SEED_MDP_ADMIN=
SEED_MDP_STANDARDISTE=
SEED_MDP_BARMAN=
SEED_MDP_CAISSIER=

# ---------- Console de licence (interrupteur privé) ----------
# Contrôle l'accès à l'application. Ces valeurs vivent ici, sur le serveur, jamais
# dans la base de données de l'application. Sans elles, la console reste inaccessible.
#
#   CONTROLE_LOGIN      : votre identifiant de connexion à la console.
#   CONTROLE_MDP_HASH   : l'EMPREINTE bcrypt de votre mot de passe (jamais le mot de
#                         passe en clair). Générez-la avec :
#                           node -e "console.log(require('bcrypt').hashSync('VotreMotDePasse', 10))"
#   CONTROLE_JWT_SECRET : une longue chaîne aléatoire, DIFFÉRENTE de JWT_SECRET.
#                         Générez-la avec : openssl rand -hex 32
CONTROLE_LOGIN=
CONTROLE_MDP_HASH=
CONTROLE_JWT_SECRET=
